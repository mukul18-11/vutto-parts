# Copy to .env for local development and tests. Never commit real values.
# Local values come from `pnpm supabase status -o env` after `pnpm supabase start`.
# Production values live only in .env.prod.local (gitignored); tests and app code never read it.

# --- App (also set in Vercel → Production) -------------------------------------------------

# Supabase API URL. Local: http://127.0.0.1:54321. Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The PUBLISHABLE key (sb_publishable_…; a legacy anon eyJ… key also works). Never the secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" shows the one-tap demo sign-in buttons on /login.
NEXT_PUBLIC_DEMO_MODE=true

# Shared password of the five demo logins. Server-only: never prefix it with NEXT_PUBLIC_.
# Required when NEXT_PUBLIC_DEMO_MODE=true.
DEMO_PASSWORD=

# --- Scripts and tests only (never in Vercel) ----------------------------------------------

# Used by scripts/ (pnpm demo:users) and test helpers. Tests require http://127.0.0.1:54321.
SUPABASE_URL=http://127.0.0.1:54321

# The SECRET key (sb_secret_…; legacy service_role eyJ… also works). Local value only here.
# In production it exists only as a GitHub Actions secret. Never in Vercel, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for DB integration tests (must be 127.0.0.1 or localhost).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- GitHub Actions secrets only (demo-guard workflow) -------------------------------------
# SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and DEMO_PASSWORD
# with production values, plus:
# PROD_URL=https://<your-app>.vercel.app

# --- Set automatically; do not add these yourself -----------------------------------------
# NEXT_PUBLIC_COMMIT_SHA  set by next.config from VERCEL_GIT_COMMIT_SHA ("local" elsewhere)
# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA  provided by Vercel
